rules_version = '2';

// Roll v2 — Firestore security rules for NIT Hamirpur.
// Mirrors app/src/main/java/app/roll/domain/college/NithConfig.kt (domain, email pattern, branch
// codes, admin list). Tested in rules-tests/ against the emulator. Keep all three in step.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity, all derived from the verified Google email ----------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function verified() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // "26bma038" from "26bma038@nith.ac.in".
    function localPart() {
      return email().split('@')[0];
    }

    // Branch codes Roll supports. Adding a branch: add it here and in NithConfig.branches.
    function supportedBranch(code) {
      return code in ['ma', 'cs', 'ch', 'ce', 'me', 'ec'];
    }

    // A Bachelor's student of a supported branch: <YY>b<branch><NNN>@nith.ac.in.
    function collegeStudent() {
      return verified()
        && email().matches('^[0-9]{2}b[a-z]{2}[0-9]{3}@nith[.]ac[.]in$')
        && supportedBranch(localPart()[3:5]);
    }

    // Admin accounts. Also in NithConfig.adminEmails.
    function isAdmin() {
      return verified() && email() in ['26bma038@nith.ac.in'];
    }

    function validUser() {
      return collegeStudent() || isAdmin();
    }

    function parsedBatch() {
      return 2000 + int(localPart()[0:2]);
    }

    function parsedBranch() {
      return localPart()[3:5].upper();
    }

    function parsedRollNo() {
      return localPart().upper();
    }

    // "nith-26-ma". Sections could later become "nith-26-ma-a".
    function myClassId() {
      return 'nith-' + localPart()[0:2] + '-' + localPart()[3:5];
    }

    function isMyClass(classId) {
      return collegeStudent() && classId == myClassId();
    }

    function classDoc(classId) {
      return /databases/$(database)/documents/classes/$(classId);
    }

    function memberDoc(classId, uid) {
      return /databases/$(database)/documents/classes/$(classId)/members/$(uid);
    }

    function isCR(classId) {
      return isMyClass(classId) && request.auth.uid in get(classDoc(classId)).data.crUids;
    }

    // Assignments and notices: CRs of the class, or the admin.
    function canPost(classId) {
      return isCR(classId) || isAdmin();
    }

    function canReadClass(classId) {
      return isMyClass(classId) || isAdmin();
    }

    // ---------- value checks ----------

    function hasExactly(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    function validText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validMinutes(m) {
      return m is int && m >= 0 && m < 1440;
    }

    function validType(t) {
      return t in ['lecture', 'lab', 'tutorial'];
    }

    // "2026-11-05" -> timestamp at 00:00 UTC of that date.
    function dateOf(d) {
      let parts = d.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }

    // Today's date in Asia/Kolkata (UTC+5:30), as a timestamp at 00:00 UTC.
    function istToday() {
      let t = request.time + duration.value(330, 'm');
      return timestamp.date(t.year(), t.month(), t.day());
    }

    // Today or the two days before it. Mirrors EditWindow in the app.
    function inEditWindow(d) {
      let day = dateOf(d);
      let today = istToday();
      return day <= today && day >= today - duration.value(2, 'd');
    }

    // ---------- users ----------
    // Roll number, batch, branch and class come from the email and can never be edited.

    match /users/{uid} {
      allow read: if (isSelf(uid) && validUser()) || isAdmin();

      allow create: if isSelf(uid)
        && collegeStudent()
        && hasExactly(request.resource.data, ['name', 'rollNo', 'email', 'batch', 'branch', 'classId', 'createdAt'])
        && validText(request.resource.data.name, 1, 60)
        && request.resource.data.rollNo == parsedRollNo()
        && request.resource.data.email == email()
        && request.resource.data.batch == parsedBatch()
        && request.resource.data.branch == parsedBranch()
        && request.resource.data.classId == myClassId()
        && request.resource.data.createdAt == request.time;

      allow update: if isSelf(uid)
        && collegeStudent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validText(request.resource.data.name, 1, 60);

      allow delete: if isSelf(uid);

      // Private "done" ticks for assignments. Nobody else, not even the admin, can see them.
      match /assignmentStatus/{assignmentId} {
        allow read, delete: if isSelf(uid) && validUser();
        allow create, update: if isSelf(uid)
          && validUser()
          && hasExactly(request.resource.data, ['done', 'doneAt'])
          && request.resource.data.done is bool
          && request.resource.data.doneAt == request.time;
      }
    }

    // ---------- departments (admin-maintained, read by every student) ----------

    match /departments/{code} {
      allow read: if validUser();
      allow write: if isAdmin()
        && supportedBranch(code.lower())
        && hasExactly(request.resource.data, ['code', 'name', 'about', 'hod', 'office', 'email', 'phone', 'links', 'updatedAt'])
        && request.resource.data.code == code
        && validText(request.resource.data.name, 1, 80)
        && validText(request.resource.data.about, 0, 1000)
        && validText(request.resource.data.hod, 0, 80)
        && validText(request.resource.data.office, 0, 120)
        && validText(request.resource.data.email, 0, 80)
        && validText(request.resource.data.phone, 0, 40)
        && request.resource.data.links is list
        && request.resource.data.links.size() <= 10
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- notices ----------

    function validNotice(data) {
      return hasExactly(data, ['text', 'pinned', 'createdAt', 'expiresAt', 'createdByName', 'status', 'updatedAt'])
        && validText(data.text, 1, 500)
        && data.pinned is bool
        && (data.expiresAt == null || data.expiresAt is timestamp)
        && data.createdByName is string
        && data.status in ['active', 'deleted']
        && data.updatedAt == request.time;
    }

    function noticeCreate() {
      return validNotice(request.resource.data) && request.resource.data.createdAt == request.time;
    }

    function noticeUpdate() {
      return validNotice(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
    }

    // College-wide, posted by the admin.
    match /notices/{noticeId} {
      allow read: if validUser();
      allow create: if isAdmin() && noticeCreate();
      allow update: if isAdmin() && noticeUpdate();
    }

    // ---------- classes ----------

    match /classes/{classId} {
      // Students read their own class; the admin reads (and lists) all of them.
      allow read: if canReadClass(classId);

      // The first student of a batch + branch creates its class, with no CRs, together with
      // their own member doc (so memberCount starts at 1).
      allow create: if isMyClass(classId)
        && hasExactly(request.resource.data, ['name', 'semester', 'batch', 'branch', 'crUids', 'crNames',
                                              'requiredPercent', 'timezone', 'memberCount', 'createdAt'])
        && validText(request.resource.data.name, 1, 80)
        && validText(request.resource.data.semester, 0, 60)
        && request.resource.data.batch == parsedBatch()
        && request.resource.data.branch == parsedBranch()
        && request.resource.data.crUids == []
        && request.resource.data.crNames == []
        && request.resource.data.requiredPercent == 75
        && request.resource.data.timezone == 'Asia/Kolkata'
        && request.resource.data.memberCount == 1
        && existsAfter(memberDoc(classId, request.auth.uid))
        && request.resource.data.createdAt == request.time;

      allow update: if
        // A CR edits name, semester and required %; never the CR list.
        (isCR(classId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'semester', 'requiredPercent'])
          && validClassSettings(request.resource.data))
        // The admin appoints and removes CRs (and may fix settings).
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['crUids', 'crNames', 'name', 'semester', 'requiredPercent'])
          && request.resource.data.crUids is list
          && request.resource.data.crUids.size() <= 3
          && request.resource.data.crNames is list
          && request.resource.data.crNames.size() == request.resource.data.crUids.size()
          && validClassSettings(request.resource.data))
        // Joining or leaving moves the member count by one, together with the member doc.
        || (isMyClass(classId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          && ((request.resource.data.memberCount == resource.data.memberCount + 1
                && !exists(memberDoc(classId, request.auth.uid))
                && existsAfter(memberDoc(classId, request.auth.uid)))
              || (request.resource.data.memberCount == resource.data.memberCount - 1
                && exists(memberDoc(classId, request.auth.uid))
                && !existsAfter(memberDoc(classId, request.auth.uid)))));

      allow delete: if false;

      function validClassSettings(data) {
        return validText(data.name, 1, 80)
          && validText(data.semester, 0, 60)
          && data.requiredPercent is int && data.requiredPercent >= 1 && data.requiredPercent <= 100;
      }

      // ---------- members ----------
      // Only the CRs and the admin see the list. Students see counts and CR names on the class doc.

      match /members/{uid} {
        allow read: if isSelf(uid) || isCR(classId) || isAdmin();

        allow create: if isSelf(uid)
          && isMyClass(classId)
          && hasExactly(request.resource.data, ['name', 'rollNo', 'joinedAt'])
          && validText(request.resource.data.name, 1, 60)
          && request.resource.data.rollNo == parsedRollNo()
          && request.resource.data.joinedAt == request.time;

        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && validText(request.resource.data.name, 1, 60);

        // Only when deleting your own account.
        allow delete: if isSelf(uid) && isMyClass(classId);
      }

      // ---------- subjects, timetable (CRs only) ----------

      match /subjects/{subjectId} {
        allow read: if canReadClass(classId);
        allow create, update: if isCR(classId)
          && hasExactly(request.resource.data, ['name', 'shortName', 'code', 'faculty', 'colorIndex', 'archived'])
          && validText(request.resource.data.name, 1, 80)
          && validText(request.resource.data.shortName, 1, 10)
          && request.resource.data.colorIndex is int
          && request.resource.data.archived is bool;
        allow delete: if isCR(classId);
      }

      match /timetable/{slotId} {
        allow read: if canReadClass(classId);
        allow create, update: if isCR(classId)
          && hasExactly(request.resource.data, ['dayOfWeek', 'startMinutes', 'endMinutes', 'subjectId', 'type', 'room'])
          && request.resource.data.dayOfWeek is int
          && request.resource.data.dayOfWeek >= 1 && request.resource.data.dayOfWeek <= 7
          && validMinutes(request.resource.data.startMinutes)
          && validMinutes(request.resource.data.endMinutes)
          && request.resource.data.endMinutes > request.resource.data.startMinutes
          && validType(request.resource.data.type);
        allow delete: if isCR(classId);
      }

      // ---------- sessions (CRs only) ----------

      function validSession(data) {
        return hasExactly(data, ['subjectId', 'date', 'startMinutes', 'endMinutes', 'type', 'status',
                                 'note', 'room', 'weight', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
          && data.subjectId is string
          && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && validMinutes(data.startMinutes)
          && validMinutes(data.endMinutes)
          && data.endMinutes > data.startMinutes
          && validType(data.type)
          && data.status in ['scheduled', 'cancelled', 'deleted']
          && validText(data.note, 0, 200)
          && data.room is string
          && data.weight is int && data.weight >= 1 && data.weight <= 4
          && data.updatedAt == request.time;
      }

      match /sessions/{sessionId} {
        allow read: if canReadClass(classId);
        allow create: if isCR(classId)
          && validSession(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if isCR(classId)
          && validSession(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isCR(classId);

        // One doc per student per session, id = their uid. "cleared" is a tombstone for delta sync.
        match /marks/{uid} {
          allow read: if isSelf(uid) || isCR(classId);

          allow create, update: if isSelf(uid)
            && isMyClass(classId)
            && hasExactly(request.resource.data, ['status', 'markedAt', 'uid', 'classId', 'sessionId'])
            && request.resource.data.status in ['present', 'absent', 'cleared']
            && request.resource.data.markedAt == request.time
            && request.resource.data.uid == uid
            && request.resource.data.classId == classId
            && request.resource.data.sessionId == sessionId
            && get(/databases/$(database)/documents/classes/$(classId)/sessions/$(sessionId)).data.status == 'scheduled'
            && inEditWindow(get(/databases/$(database)/documents/classes/$(classId)/sessions/$(sessionId)).data.date);

          // Only a CR, when deleting a session.
          allow delete: if isCR(classId);
        }
      }

      // ---------- assignments (CRs and admin) ----------

      function validAssignment(data) {
        return hasExactly(data, ['title', 'subjectId', 'type', 'description', 'link', 'dueAt',
                                 'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'status'])
          && validText(data.title, 1, 120)
          && data.subjectId is string
          && data.type in ['assignment', 'lab_report', 'quiz', 'mid_sem', 'end_sem', 'presentation', 'other']
          && validText(data.description, 0, 2000)
          && validText(data.link, 0, 500)
          && data.dueAt is timestamp
          && data.createdByName is string
          && data.status in ['active', 'deleted']
          && data.updatedAt == request.time;
      }

      match /assignments/{assignmentId} {
        allow read: if canReadClass(classId);
        allow create: if canPost(classId)
          && validAssignment(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        // Deleting is a tombstone update (status "deleted") so incremental sync sees it.
        allow update: if canPost(classId)
          && validAssignment(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // ---------- class notices (CRs and admin) ----------

      match /notices/{noticeId} {
        allow read: if canReadClass(classId);
        allow create: if canPost(classId) && noticeCreate();
        allow update: if canPost(classId) && noticeUpdate();
      }
    }

    // A student's own marks across all sessions, for computing percentages on device.
    match /{path=**}/marks/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
