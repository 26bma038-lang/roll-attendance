{
  "name": "roll-timetable-import",
  "private": true,
  "type": "module",
  "description": "Turns the college's timetable PDF into Roll subjects and weekly slots: extract a draft with Gemini (free tier), check it, then apply it.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "extract": "node src/extract.js",
    "apply": "node src/apply.js",
    "sample-pdf": "node scripts/make-sample-pdf.js",
    "test": "node --test test/draft.test.js test/gemini.test.js test/plan.test.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.3"
  }
}
