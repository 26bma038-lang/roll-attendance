{
  "name": "roll-rules-tests",
  "private": true,
  "type": "module",
  "description": "Firestore security rules tests for Roll, run against the local emulator.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-roll --config ../firebase.json \"node --test --test-concurrency=1 test/rules.test.js\"",
    "test:only": "node --test --test-concurrency=1 test/rules.test.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.2.0",
    "firebase-tools": "^15.35.0"
  }
}
