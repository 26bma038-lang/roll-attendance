<?xml version="1.0" encoding="utf-8"?>
<!-- Back up only device preferences (theme, reminder). Firestore data comes back from the server. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
